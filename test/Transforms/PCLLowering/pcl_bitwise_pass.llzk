// CHECK-LABEL:   func.func @BitXor(
// CHECK-SAME:        %[[A:[0-9a-zA-Z_\.]+]]: !pcl.felt,
// CHECK-SAME:        %[[B:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[OUT:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK:           %[[B0:[0-9a-zA-Z_\.]+]] = pcl.var "_nondet_internal_var__
// CHECK:           pcl.eq %{{.*}}, %[[A]]
// CHECK-NEXT:      pcl.assert
// CHECK:           pcl.eq %{{.*}}, %[[B]]
// CHECK-NEXT:      pcl.assert
// XOR: out_0 = lhs_0 + rhs_0 − 2·(lhs_0·rhs_0) (add prod,prod doubles).
// CHECK:           %[[SUM0:[0-9a-zA-Z_\.]+]] = pcl.add %[[B0]], %{{[0-9a-zA-Z_\.]+}}
// CHECK-NEXT:      %[[PROD0:[0-9a-zA-Z_\.]+]] = pcl.mul %[[B0]], %{{[0-9a-zA-Z_\.]+}}
// CHECK-NEXT:      %[[TWOPROD0:[0-9a-zA-Z_\.]+]] = pcl.add %[[PROD0]], %[[PROD0]]
// CHECK-NEXT:      pcl.sub %[[SUM0]], %[[TWOPROD0]]
// CHECK:           %[[OUT_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %{{.*}}, %[[OUT]]
// CHECK-NEXT:      pcl.assert %[[OUT_EQ]]
// CHECK-NEXT:      pcl.return %[[OUT]]

// BUDGET-LABEL:    func.func @BitXor(
// BUDGET-COUNT-67: pcl.assert
// BUDGET-NOT:      pcl.assert

// -----

module attributes {llzk.lang} {
  struct.def @BitNot {
    struct.member @out : !felt.type<"koalabear"> {llzk.pub}
    function.def @compute(%a: !felt.type<"koalabear">) -> !struct.type<@BitNot> {
      %self = struct.new : <@BitNot>
      function.return %self : !struct.type<@BitNot>
    }
    function.def @constrain(%self: !struct.type<@BitNot>, %a: !felt.type<"koalabear">) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
      %0 = felt.bit_not %a : !felt.type<"koalabear">
      %1 = struct.readm %self[@out] : !struct.type<@BitNot>, !felt.type<"koalabear">
      constrain.eq %0, %1 : !felt.type<"koalabear">, !felt.type<"koalabear">
      function.return
    }
  }
}

// CHECK-LABEL:   func.func @BitNot(
// CHECK-SAME:        %[[A:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[OUT:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK:           %[[B0:[0-9a-zA-Z_\.]+]] = pcl.var "_nondet_internal_var__
// CHECK:           pcl.eq %{{.*}}, %[[A]]
// CHECK-NEXT:      pcl.assert
// NOT: out_0 = 1 − lhs_0 (fresh const per bit).
// CHECK:           %[[BIT_ONE:[0-9a-zA-Z_\.]+]] = pcl.const  1
// CHECK-NEXT:      pcl.sub %[[BIT_ONE]], %[[B0]]
// CHECK:           %[[OUT_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %{{.*}}, %[[OUT]]
// CHECK-NEXT:      pcl.assert %[[OUT_EQ]]
// CHECK-NEXT:      pcl.return %[[OUT]]

// BUDGET-LABEL:    func.func @BitNot(
// BUDGET-COUNT-34: pcl.assert
// BUDGET-NOT:      pcl.assert
