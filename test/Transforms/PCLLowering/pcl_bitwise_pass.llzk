// CHECK-LABEL:   func.func @BitNot(
// CHECK-SAME:        %[[A:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[OUT:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK:           %[[B0:[0-9a-zA-Z_\.]+]] = pcl.var "_nondet_internal_var__
// CHECK:           pcl.eq %{{.*}}, %[[A]]
// CHECK-NEXT:      pcl.assert
// NOT: out_0 = 1 − lhs_0 (fresh const per bit).
// CHECK:           %[[BIT_ONE:[0-9a-zA-Z_\.]+]] = pcl.const  1
// CHECK-NEXT:      pcl.sub %[[BIT_ONE]], %[[B0]]
// CHECK:           %[[OUT_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %{{.*}}, %[[OUT]]
// CHECK-NEXT:      pcl.assert %[[OUT_EQ]]
// CHECK-NEXT:      pcl.return %[[OUT]]

// BUDGET-LABEL:    func.func @BitNot(
// BUDGET-COUNT-34: pcl.assert
// BUDGET-NOT:      pcl.assert

