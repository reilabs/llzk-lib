// CHECK-LABEL:   func.func @BitOr(
// CHECK-SAME:        %[[A:[0-9a-zA-Z_\.]+]]: !pcl.felt,
// CHECK-SAME:        %[[B:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[OUT:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK:           %[[B0:[0-9a-zA-Z_\.]+]] = pcl.var "_nondet_internal_var__
// CHECK:           pcl.eq %{{.*}}, %[[A]]
// CHECK-NEXT:      pcl.assert
// CHECK:           pcl.eq %{{.*}}, %[[B]]
// CHECK-NEXT:      pcl.assert
// OR: out_0 = lhs_0 + rhs_0 − lhs_0·rhs_0 (sub directly after mul).
// CHECK:           %[[SUM0:[0-9a-zA-Z_\.]+]] = pcl.add %[[B0]], %{{[0-9a-zA-Z_\.]+}}
// CHECK-NEXT:      %[[PROD0:[0-9a-zA-Z_\.]+]] = pcl.mul %[[B0]], %{{[0-9a-zA-Z_\.]+}}
// CHECK-NEXT:      pcl.sub %[[SUM0]], %[[PROD0]]
// CHECK:           %[[OUT_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %{{.*}}, %[[OUT]]
// CHECK-NEXT:      pcl.assert %[[OUT_EQ]]
// CHECK-NEXT:      pcl.return %[[OUT]]

// BUDGET-LABEL:    func.func @BitOr(
// BUDGET-COUNT-67: pcl.assert
// BUDGET-NOT:      pcl.assert

// -----

